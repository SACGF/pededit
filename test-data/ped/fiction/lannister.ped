LANN	Lancel	Kevan	Dorna_Swyft	1	1
LANN	Willem	Kevan	Dorna_Swyft	1	1
LANN	Martyn	Kevan	Dorna_Swyft	1	1
LANN	Janei	Kevan	Dorna_Swyft	2	1
# Genna's sons by Emmon Frey
LANN	Cleos_Frey	Emmon_Frey	Genna	1	1
LANN	Lyonel_Frey	Emmon_Frey	Genna	1	1
LANN	Tion_Frey	Emmon_Frey	Genna	1	1
LANN	Walder_Frey	Emmon_Frey	Genna	1	1
# Tygett's and Gerion's children
LANN	Tyrek	Tygett	Darlessa_Marbrand	1	1
LANN	Joy_Hill	Gerion	Briony	2	1
