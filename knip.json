{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "frontend": {
      "entry": [
        "scripts/*.mjs!",
        "scripts/browser/*.mjs!",
        "scripts/browser/flows/*.mjs!",
        "src/lib/google-oauth-noop.tsx!"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}!",
        "scripts/**/*.mjs!",
        "!src/**/__tests__/**!",
        "!src/**/*.test.{ts,tsx}!"
      ],
      "ignore": [
        "src/components/ui/**"
      ],
      "ignoreUnresolved": [
        "^/src/"
      ]
    },
    "layout-engine": {
      "project": [
        "src/**/*.ts!"
      ]
    }
  }
}
