# Settings for deploy/backup.sh  ->  /etc/pededit/backup.env
# Owner root:pededit, mode 640. The script refuses a file that others can read
# or write, because it is sourced as shell. Every line is optional; the values
# shown commented out are the defaults.

#BACKUP_DIR=/var/backups/pededit
#BACKUP_KEEP_DAILY=14
#BACKUP_KEEP_WEEKLY=8
#BACKUP_KEEP_PREDEPLOY=5

# ── Off-box copy ─────────────────────────────────────────────────────────────
# Without one of these the backup is local only and the script says so on
# every run. Both can be set. Each mirrors the kept dumps, so the copies
# follow the same retention.

# Object storage with rclone (S3, Backblaze B2, and so on): "remote:path" as
# set up with `rclone config`. Keep the rclone config with the other secrets.
#BACKUP_RCLONE_DEST=b2:my-bucket/pededit
#export RCLONE_CONFIG=/etc/pededit/rclone.conf

# A second host over ssh with rsync. The key must be readable by the pededit
# user and the host already in ~pededit/.ssh/known_hosts.
#BACKUP_RSYNC_DEST=backup@backup.example.org:/srv/backups/pededit
#BACKUP_RSYNC_SSH_KEY=/etc/pededit/backup_ssh_key

# ── Encryption of the off-box copy ───────────────────────────────────────────
# A GnuPG PUBLIC key file. When set, only encrypted copies leave the server,
# and they can be read only with the private key, which must not be on this
# server. Without the private key the copies cannot be restored: keep it
# somewhere that survives losing this server and the machine it was made on.
#BACKUP_GPG_PUBLIC_KEY=/etc/pededit/backup-public-key.asc

# ── Being told when backups stop ─────────────────────────────────────────────
# A URL fetched after each successful nightly run. Point it at a dead man's
# switch (healthchecks.io or similar) that alerts when the ping is late.
#BACKUP_PING_URL=https://hc-ping.com/your-uuid
